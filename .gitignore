# Default: ignore everything unless explicitly allowlisted below.
*

# Core repo metadata and top-level docs.
!.gitignore
!README.md
!requirements.txt

# Entrypoints.
!run_rdfizer.py
!visualize_rdf.py

# Visualizer support assets.
!lib/
!lib/**

# Engine source.
!rdfizer_star/
!rdfizer_star/**
rdfizer_star/**/__pycache__/
rdfizer_star/**/*.py[cod]

# Keep one small runnable reference scenario in-repo.
!scenarios/
scenarios/*
!scenarios/composite_quoted_probe/
!scenarios/composite_quoted_probe/**
scenarios/composite_quoted_probe/output/
scenarios/composite_quoted_probe/results/
scenarios/composite_quoted_probe/materialized/
scenarios/composite_quoted_probe/**/__pycache__/

# Optional thesis slot: when you provide the PDF, place it here and it will be tracked.
!docs/
docs/*
!docs/thesis/
docs/thesis/*
!docs/thesis/master_thesis.pdf
