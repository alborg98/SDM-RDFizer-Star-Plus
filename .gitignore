# Default: ignore everything unless explicitly allowlisted below.
*

# Core repo metadata and top-level docs.
!.gitignore
!README.md
!requirements.txt

# Entrypoints.
!run_rdfizer.py

# Engine source.
!rdfizer_star/
!rdfizer_star/**
rdfizer_star/**/__pycache__/
rdfizer_star/**/*.py[cod]

# Scenarios: local development only, not tracked.
scenarios/

# Optional thesis slot: when you provide the PDF, place it here and it will be tracked.
!docs/
docs/*
!docs/thesis/
docs/thesis/*
!docs/thesis/master_thesis.pdf
